# Google Auth Platform -> Clients -> Web application -> Client ID (not the client secret)
GOOGLE_CLIENT_ID=

# Generate with: npm run auth:secret
# Keep this secret in .env.local locally, and in Vercel Environment Variables in production.
AUTH_SESSION_SECRET=

# Use http://localhost:3000 for local development.
# In Vercel set this to https://ticky-tracker.vercel.app
APP_ORIGIN=http://localhost:3000
